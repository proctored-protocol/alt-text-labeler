APP_ENV=local
LOG_LEVEL=INFO

# Firehose
FIREHOSE_BASE_URI=wss://bsky.network/xrpc
FIREHOSE_DRY_RUN=true

# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5434/alt_labeler

# Labels
LABEL_MISSING_ALT=missing-alt-text
LABEL_PARTIAL_ALT=partial-alt-text

# Bluesky account used for Ozone-proxied moderation auth
BSKY_HANDLE=alt-text-labeler.bsky.social
BSKY_APP_PASSWORD=
BSKY_PDS_URL=https://bsky.social

# Ozone/AppView bridge
OZONE_BASE_URL=https://stropharia.us-west.host.bsky.network
OZONE_PROXY_DID=did:plc:rh3vjqs4npfpmnkkmx4u4bzj#atproto_labeler
OZONE_HANDLE=alt-text-labeler.bsky.social
OZONE_APP_PASSWORD=
PUBLISH_VIA_OZONE=false

# Optional: test from the perspective of a subscribed viewer account
TEST_VIEWER_HANDLE=
TEST_VIEWER_APP_PASSWORD=